# Ignore vim swap files
*.swp
# Ignore any mac DS_Store files
.DS_Store
# Ignore build HTML output
html/*
# Ignore local test filese
footer.html
include/*
manual/*
# Ignore any CertBot files
.well-known
.well-known/*
# Ignore Git internals but allow .github directory for CI workflows
.git*
!.github
!.github/**
# Static manual build and browser evidence
node_modules/
__pycache__/
/tests/browser/artifacts/
html-artifacts/
.coverage
/html-check/

/manual-artifacts/
navigation-report.json
!.gitattributes
